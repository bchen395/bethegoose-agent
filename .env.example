# .env.example — copy to .env.local and fill in. NEVER commit the filled copy.
#
#   cp .env.example .env.local
#
# Every value below is required unless marked optional. On Vercel, set the same
# keys as Environment Variables (scripts/vercel-env.sh pushes them); see DEPLOY.md.

# --- Server-only (NEVER prefix with NEXT_PUBLIC_) ----------------------------

# Anthropic API key — the Strategy + Content agents. Server-side only.
ANTHROPIC_API_KEY=sk-ant-...

# Supabase Postgres. DATABASE_URL is the Supavisor *transaction pooler* (port
# 6543) used by the app; DIRECT_URL is the direct connection (port 5432) used for
# DDL/migrations, where the pooler is unreliable.
# Dashboard -> Connect -> Connection String -> Transaction pooler / Direct connection.
DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:6543/postgres
DIRECT_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres

# Supabase service-role key. Bypasses RLS — server-side only, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the Vercel cron routes. The routes require
# `Authorization: Bearer $CRON_SECRET`. Generate one: openssl rand -hex 32
CRON_SECRET=

# --- Auth allow-list ---------------------------------------------------------

# REQUIRED. Comma-separated emails permitted to sign in. Supabase magic-link
# sign-up is open by default, so this list is the only thing standing between a
# stranger's inbox and your API spend. lib/auth.ts FAILS CLOSED: leave this empty
# and nobody can sign in (by design — a missing env var must never open the app).
ALLOWED_EMAILS=you@example.com

# --- Public (safe to ship in the browser bundle) -----------------------------

NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Stripe (optional — shop sync) -------------------------------------------

# Use a RESTRICTED, read-only key scoped to Products + Prices. lib/shop.ts only
# ever lists products. Omit to disable the shop-sync cron (it no-ops).
STRIPE_SECRET_KEY=rk_live_...

# --- Instagram (optional — stats auto-pull) ----------------------------------

# Meta app credentials; see INSTAGRAM_SETUP.md. REDIRECT_URI must match the Meta
# app's configured redirect URI exactly. Omit all three to disable the IG sync.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://<your-vercel-domain>/api/instagram/callback
